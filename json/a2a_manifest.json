  "schema": "volt-is.a2a/1.0",
  "protocol": {
    "name": "Agent-to-Agent (A2A)",
    "version": "0.3.0",
    "transport": "HTTP + JSON",
    "message_format": "JSON-RPC 2.0 compatible",
    "discovery": "AgentCard sur /.well-known/agent.json",
